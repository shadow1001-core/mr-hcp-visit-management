# Application
APP_ENV=development
BUSINESS_TIMEZONE=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=mr_hcp
POSTGRES_USER=mr_hcp
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://mr_hcp:replace-with-local-password@localhost:5432/mr_hcp
TEST_DATABASE_URL=postgresql+psycopg://mr_hcp:replace-with-local-password@localhost:5432/mr_hcp_test
COMPOSE_DATABASE_URL=postgresql+psycopg://mr_hcp:replace-with-local-password@db:5432/mr_hcp

# Docker Compose host ports
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
